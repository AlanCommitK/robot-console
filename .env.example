# 复制成 .env 再按需修改：cp .env.example .env
# .env 只给 docker-compose.yml 做 ${VAR} 替换用；本文件的值都是开发环境默认值，切勿用于生产。
# .env 已被 .gitignore 忽略，可以放本机私有配置（例如镜像源）。

# ---- 构建镜像用的国内镜像源（只在 docker compose build 时使用；留空 = 官方 PyPI / npm 源）----
# PIP_INDEX_URL：backend、simulator 镜像的 pip；NPM_REGISTRY：前端镜像的 npm ci
PIP_INDEX_URL=
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_REGISTRY=
# NPM_REGISTRY=https://registry.npmmirror.com

# ---- PostgreSQL（改用户名/密码时要同步改下面的 DATABASE_URL）----
POSTGRES_DB=robot
POSTGRES_USER=robot
POSTGRES_PASSWORD=robot

# ---- backend：api-1 / api-2 / migrate（SPEC §4）----
DATABASE_URL=postgresql+asyncpg://robot:robot@postgres:5432/robot
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
JWT_SECRET=dev-secret-change-me-at-least-32-bytes-long
JWT_EXPIRE_MINUTES=480
COMMAND_TTL_MS=30000
ACK_TIMEOUT_S=10
# 机器人 ack 之后最多等多少秒的结果，超时由 sweeper 判为 failed（result_timeout）
RESULT_TIMEOUT_S=300
ROBOT_ONLINE_TTL_S=5
TELEMETRY_FLUSH_INTERVAL_S=1.0
# backend 和 simulator 共用
LOG_LEVEL=INFO
# 只给 vite 开发服务器（npm run dev，端口 5173）用；走 nginx 时是同源请求，不需要 CORS
CORS_ORIGINS=http://localhost:5173

# ---- simulator（SPEC §17）----
WS_URL=ws://nginx/ws/robot
ROBOTS=robot-1:dev-token-robot-1,robot-2:dev-token-robot-2,robot-3:dev-token-robot-3,robot-4:dev-token-robot-4
TELEMETRY_HZ=5
# 每个机器人平均每分钟随机断线次数；0 = 关闭混沌测试
CHAOS_DISCONNECT_PER_MIN=0.5
FAIL_RATE=0.05

# ---- Grafana（只在第一次创建 grafana-data 卷时生效）----
GRAFANA_ADMIN_PASSWORD=admin
